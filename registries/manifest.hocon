{
    # The optimiser wakes itself. There is no user on the other end of this and
    # no request to answer -- neuro-san fires it on the schedule below.
    #
    # Hourly, not every fifteen minutes. A wake evaluates up to three candidates
    # and the free tier buys about three a day, so a faster schedule would only
    # produce wakes that find the budget already spent and decline. The cadence
    # is set by what the provider allows, not by how often we would like news.
    "optimizer.hocon": {
        "serve": true,

        # Not listed by default. "public": false is neuro-san's "protected":
        # hidden from the Concierge list but still callable over the server's
        # web API by anyone who can reach the port. This agent spends real
        # provider budget when asked to run, and the day's budget is about three
        # evaluations, so the server must not be reachable from untrusted
        # networks at all -- compose.yaml publishes no port; see SERVING.md.
        #
        # Set ESP_OPTIMIZER_PUBLIC=true to list it for a local demonstration.
        "public": false,
        "public": ${?ESP_OPTIMIZER_PUBLIC},
        "periodic": {
            "interactions": [
                {
                    "enable": true,
                    "cron_schedule": "0 * * * *",
                    "cron_schedule": ${?ESP_OPTIMIZER_CRON},
                    "second_at_beginning": false,
                    "text": """
Scheduled optimisation wake. Run one wake, and report only if a better
topology was found. Most wakes find nothing; say nothing when that happens.
""",
                    "metadata": {"user_id": "system"},
                },
            ],
        },
    },

    # Measures networks on request and compares them. Unlisted by default for
    # the same reason as the optimiser, and callable the same way by anyone who
    # can reach the server: every request is paid model calls, and
    # ESP_EVAL_MAX_RUNS caps them per process. ESP_EVALUATOR_PUBLIC=true lists
    # it, for a deployment whose operator means to offer measurement.
    "evaluator.hocon": {
        "serve": true,
        "public": false,
        "public": ${?ESP_EVALUATOR_PUBLIC},
    },
}
