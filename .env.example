# Copy this file to .env and paste your key in. .env is gitignored -- it will
# not be committed, and a test fails if that ever stops being true.
#
# Nothing in this repository needs a key to run the offline half of ESP. The
# search that ranks thousands of candidates, the held-out analysis and the null
# sweep all run on the twelve committed measurements with no key and no network.
# A key is needed to measure a network for real, and to talk to one.
#
# The provider is chosen the way neuro-san-studio chooses: by whichever key is
# set here. With several keys, studio's order decides -- OpenAI, then
# Anthropic, then Gemini -- and ESP_PROVIDER forces one. The preflight refuses
# to start on a configuration that would fail inside every agent, because that
# does not fail at startup: it scores every candidate zero, and the cache keeps
# those zeros.
#
# Check it with:  make check-key   then   python apps/optimizer/run_optimizer.py --check

# --- Anthropic (Claude) -----------------------------------------------------
#
# Keys: https://console.anthropic.com/settings/keys
# Workers run claude-haiku and a promoted router runs claude-sonnet. Both are
# aliases neuro-san keeps pointed at the newest release of each line.

ANTHROPIC_API_KEY=paste-your-key-here

# --- or OpenAI ----------------------------------------------------------------
#
# Workers run gpt-5.4-mini and a promoted router runs gpt-5.5.
# OPENAI_API_KEY=paste-your-key-here

# --- or Google Gemini ---------------------------------------------------------
#
# The twelve committed measurements were taken on Gemini, so this is the only
# provider on which they can be adopted (scripts/adopt_measurements.py). On any
# other provider the population starts from `make baseline`.
#
# GOOGLE_API_KEY=paste-your-key-here
#
# Google's free tier caps each model per day. Several keys from several projects
# widen that, and the rate limiter rotates through them:
# GOOGLE_API_KEYS=key-from-project-a,key-from-project-b
#
# Which free-tier models to fail over between, with their daily caps. `make
# probe` measures the caps against your key. Ignored on every other provider.
# ESP_MODELS=gemini-3.5-flash-lite:500,gemini-3.1-flash-lite:500

# --- or OpenRouter ------------------------------------------------------------
#
# Install the driver first:  pip install -e ".[openrouter]"
# OPENROUTER_API_KEY=paste-your-key-here
# ESP_DEFAULT_MODEL=openrouter/free

# --- Changing provider --------------------------------------------------------
#
# The model is part of every genome hash. A fitness measured on one provider
# does not describe the same network on another, so the cache misses and the
# measurements start again. That is deliberate. Do not compare numbers across
# providers, and do not carry a state directory from one provider to another --
# the preflight refuses to.

# --- Everything below is optional ---------------------------------------------

# Force a provider when more than one key is set: anthropic, openai or google.
# ESP_PROVIDER=anthropic

# Any model neuro-san resolves, for the workers. It takes the rung it belongs
# on: a strong choice (claude-opus) becomes what a router is promoted to.
# ESP_DEFAULT_MODEL=claude-opus
# Or set both rungs outright, cheap first.
# ESP_MODEL_TIERS=claude-haiku,claude-sonnet

# Requests per minute, per model. 14 is safe on any account and slow on a paid
# one: about twelve minutes of queueing per candidate. Set it to one under the
# per-minute limit your provider's console shows for your account.
# ESP_RPM=14

# Where the population is written. Mount this in a container: it is paid-for
# measurements, not compute.
# ESP_STATE=state

# The optimiser's schedule.
# ESP_OPTIMIZER_CRON=0 * * * *

# How long a wake may hold the lease before it is presumed dead.
# ESP_LEASE_SECONDS=3600

# Per-agent time budget. It has to cover waiting in the rate limiter, not just
# thinking -- an agent cancelled while queueing scores zero, and the search then
# concludes a perfectly good topology is bad.
# ESP_MAX_EXECUTION_SECONDS=600

# How many questions the public web page answers before it stops. Every answer
# is paid for.
# ESP_WEB_MAX_QUESTIONS=40
