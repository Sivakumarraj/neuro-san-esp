# Copy this file to .env and paste your key in. .env is gitignored -- it will
# not be committed, and a test fails if that ever stops being true.
#
# A free key takes about a minute: https://aistudio.google.com/apikey
#
# Nothing in this repository needs a key to run the search half of ESP. Phases B
# and C -- the part that ranks thousands of candidates for free -- work with no
# key, no network and no account at all. A key is only needed to measure a
# network for real.

GOOGLE_API_KEY=paste-your-key-here

# --- multiple Google keys --------------------------------------------------
#
# Google's free tier is per-project-per-model. A second key from a second
# project doubles the daily budget for the same code path -- the rate limiter
# rotates through the ring, and only when every key is exhausted for a model
# does that model retire. Two keys of 1000/day cover about 12 candidates
# instead of 6.
#
# GOOGLE_API_KEY is still needed for the first client construction; the ring
# is the wider set. Order matters only for round-robin fairness; exhaustion is
# per (key, model) pair.
#
# GOOGLE_API_KEYS=key-from-project-a,key-from-project-b

# --- or run on OpenRouter instead -------------------------------------------
#
# neuro-san ships an OpenRouter policy and picks the client class from the model
# name, so switching providers is these three lines and nothing else. Install
# the driver first:  pip install -e ".[openrouter]"
#
# "openrouter/free" is OpenRouter's own free router: it picks an available free
# model per request and moves off exhausted ones itself, which is the failover
# esp/eval/failover.py does by hand for Google.
#
# OPENROUTER_API_KEY=paste-your-openrouter-key-here
# ESP_DEFAULT_MODEL=openrouter/free
# ESP_MODEL_TIERS=openrouter/free
#
# Changing the model changes every genome hash, because the model is part of the
# genome. That is deliberate: a fitness measured on Gemini does not describe a
# network running on Llama, so the cache must miss and the measurements start
# again. Do not compare numbers across providers.

# --- everything below is optional ------------------------------------------

# Which models to use, and what each allows per day: "name:cap,name:cap".
#
# The free tier caps requests per day PER MODEL, so the number of models you
# can afford is the number of candidates you can measure. One candidate costs
# about 165 requests. The two defaults allow 500/day each -- 1,000 requests,
# about 6 candidates a day, which is not enough to train the surrogate (it
# needs 8 samples). Adding models is how you get past that in one day rather
# than three.
#
# Run `make probe` first: it reports which models answer and which are out of
# budget, and the cap comes out of the provider's own 429 payload. A model whose
# cap is below 165 is listed by the preflight and left off the ladder, because
# failing over to one spends its whole allowance without funding a candidate.
#
# Names here go to the front of the ladder, in the order written.
# ESP_MODELS=gemini-2.5-flash:1000,gemini-2.0-flash:250

# Where the population and today's budget are written. Mount this in a
# container: it is weeks of provider budget, not compute.
# ESP_STATE=state

# The optimiser's schedule. Hourly by default, because the free tier buys about
# three real evaluations a day and a faster schedule only produces wakes that
# find the budget already spent.
# ESP_OPTIMIZER_CRON=0 * * * *

# How long a wake may hold the lease before it is presumed dead.
# ESP_LEASE_SECONDS=3600

# Per-agent time budget. This has to cover waiting in the rate limiter, not just
# thinking -- an agent cancelled while queueing scores zero, and the search then
# concludes a perfectly good topology is bad.
# ESP_MAX_EXECUTION_SECONDS=600
