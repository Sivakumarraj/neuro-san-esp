{
    "name": "neuro-san-esp",

    // Pinned to 3.12. neuro-san's server imports asyncio.eager_task_factory,
    // which does not exist on 3.11 -- on the default Codespaces image the
    // server fails at startup with an AttributeError that says nothing about
    // Python versions.
    "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

    "postCreateCommand": "pip install -e '.[dev]' && cp -n .env.example .env || true",

    // Printed after the container is ready, so the first thing a newcomer sees
    // is the command that needs no credentials.
    "postAttachCommand": "echo '\\nReady. Try: make check   then   make offline   (neither needs an API key)\\nTo measure for real, paste a key into .env -- see the Quickstart in README.md\\n'",

    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python", "charliermarsh.ruff"],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": ["tests"]
            }
        }
    },

    // The two pages open in a real browser tab. In VS Code's preview the page
    // loads but its requests do not carry the forwarded port's login, so every
    // question failed with "Failed to fetch" before reaching the server.
    // 7860 is `python apps/web/serve.py`; 4173 is `make studio`, neuro-san's
    // own UI. The neuro-san server and its health probe are background
    // services, forwarded silently.
    "forwardPorts": [7860, 4173, 8080, 8081],
    "portsAttributes": {
        "7860": {"label": "web page", "onAutoForward": "openBrowser"},
        "4173": {"label": "neuro-san studio", "onAutoForward": "openBrowser"},
        "8080": {"label": "neuro-san", "onAutoForward": "silent"},
        "8081": {"label": "health", "onAutoForward": "silent"}
    }
}
